{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/data-table/*": ["../../packages/data-table/src/*"],
      "@workspace/api-client": ["../../packages/api-client/src/index.ts"],
      "@workspace/api-client/client": [
        "../../packages/api-client/src/client.gen.ts"
      ],
      "@workspace/api-client/query": [
        "../../packages/api-client/src/@tanstack/react-query.gen.ts"
      ],
      "@workspace/api-client/zod": ["../../packages/api-client/src/zod.gen.ts"],
      "@workspace/api-client/allauth": [
        "../../packages/api-client/src/allauth/index.ts"
      ],
      "@workspace/api-client/allauth/client": [
        "../../packages/api-client/src/allauth/client.gen.ts"
      ],
      "@workspace/api-client/allauth/query": [
        "../../packages/api-client/src/allauth/@tanstack/react-query.gen.ts"
      ],
      "@workspace/api-client/allauth/zod": [
        "../../packages/api-client/src/allauth/zod.gen.ts"
      ]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
