# Copiar a apps/admin/.env.local. Opcional: sin ella se usa http://localhost:8000.

# URL de la API de Django (apps/api) que usa el servidor de Next. El navegador nunca la ve: llama a
# /api en el origen del admin y next.config.mjs la reenvía (docs/architecture/auth.md).
API_URL=http://localhost:8000
