# Copiar a apps/api/.env y completar. En desarrollo (config/settings/dev.py, el default de manage.py)
# todas son opcionales: sin ellas rigen los valores por defecto de config/settings/base.py (los
# indicados abajo). Producción (config/settings/prod.py) exige además las de la sección
# "Producción". Nunca commitear el .env real.

# --- ARCA (facturación electrónica) ---------------------------------------------------------------

# homologacion (pruebas, sin validez fiscal) o produccion.
ARCA_ENVIRONMENT=homologacion

# Certificado y clave privada. Por defecto, donde los guarda `arca-setup` con carpeta base
# apps/api/certs y alias ecomm: certs/<ARCA_ENVIRONMENT>/ecomm.crt y .key. Rutas relativas a apps/api.
# ARCA_CERTIFICATE_PATH=certs/homologacion/ecomm.crt
# ARCA_PRIVATE_KEY_PATH=certs/homologacion/ecomm.key

# CUIT emisora, sin guiones. Vacía: se lee del certificado.
# ARCA_CUIT=20123456786

# Punto de venta habilitado para factura electrónica (web service) en ARCA.
ARCA_POINT_OF_SALE=1

# responsable_inscripto emite Factura A o B (según el cliente); monotributo, Factura C.
ARCA_ISSUER_VAT_CONDITION=responsable_inscripto

# Datos del emisor que se imprimen en el PDF. Si falta alguno, /invoices/{id}/pdf/ responde 400.
ARCA_ISSUER_LEGAL_NAME=Mi Empresa SRL
ARCA_ISSUER_ADDRESS=Calle Falsa 123, CABA
# Inicio de actividades, AAAA-MM-DD.
ARCA_ISSUER_ACTIVITY_START=2020-01-01
# Ingresos Brutos: número de inscripción, "Exento", etc.
ARCA_ISSUER_GROSS_INCOME=Exento

# --- Asistente del admin (Claude) -----------------------------------------------------------------

# Sin clave, los endpoints del asistente responden con un error.
ANTHROPIC_API_KEY=

# --- Cache -----------------------------------------------------------------------------------------

# Redis del cache `arca` (tickets de acceso de ARCA compartidos entre workers).
REDIS_URL=redis://127.0.0.1:6379

# --- Base de datos y frontends -------------------------------------------------------------------

# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Orígenes de los frontends, separados por coma: CSRF acepta escrituras solo desde ellos.
# FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
# CORS: vacío, ningún navegador llama a la API desde otro origen (docs/architecture/auth.md).
# CORS_ALLOWED_ORIGINS=
# Duración de la sesión del admin, en segundos (8 horas).
# SESSION_COOKIE_AGE=28800
# Duración de la sesión de los clientes de la tienda, en segundos (30 días; sobrevive al cierre del
# navegador).
# CUSTOMER_SESSION_AGE=2592000
# Ruta del Django admin, sin barra inicial. En dev es admin/; en prod, vacía (no se monta).
# DJANGO_ADMIN_URL=admin/
# 2FA obligatorio para el admin. Siempre en prod; en dev es opcional (true prueba el flujo de prod).
# REQUIRE_2FA=false
# Nombre de la cuenta en la app de autenticación.
# MFA_TOTP_ISSUER=ecomm admin

# --- Cuentas de la tienda -------------------------------------------------------------------------

# La tienda: los links de los mails de cuenta (verificación, reset de contraseña) van a sus páginas,
# y los mails se firman con su nombre. En dev los mails salen por consola.
# STORE_URL=http://localhost:3000
# URL pública de las imágenes (MEDIA_URL de Django). La tienda la usa también en next.config.mjs.
# MEDIA_URL=http://localhost:8000/media/
# STORE_NAME=Acme Store
# Client ID de OAuth de Google (tipo "Aplicación web", con la tienda como origen autorizado). Sin él,
# la tienda no muestra el botón de Google. No hace falta el secret: el login es con ID token.
# GOOGLE_CLIENT_ID=

# --- Producción (config/settings/prod.py) ---------------------------------------------------------

# Van como variables de entorno del servidor, no en un archivo del repo. Sin ellas prod no arranca.
# SECRET_KEY=
# ALLOWED_HOSTS=api.example.com
# ARCA_ENVIRONMENT=produccion
# Rutas absolutas fuera de apps/api: el certificado de producción vive solo en el servidor.
# ARCA_CERTIFICATE_PATH=/etc/ecomm/arca/ecomm.crt
# ARCA_PRIVATE_KEY_PATH=/etc/ecomm/arca/ecomm.key
# La tienda y el envío de mails de cuenta (smtp+tls://usuario:clave@host:587, etc.).
# STORE_URL=https://tienda.example.com
# MEDIA_URL=https://api.example.com/media/
# EMAIL_URL=
# DEFAULT_FROM_EMAIL=Acme Store <no-reply@example.com>
# Detrás de un proxy que termina TLS (envía X-Forwarded-Proto).
# SECURE_PROXY_SSL_HEADER=true
# SECURE_HSTS_SECONDS=31536000

# --- Tests -----------------------------------------------------------------------------------------

# ARCA_INTEGRATION_TESTS y ARCA_TEST_RECEPTOR_CUIT van solo en la línea de comandos, nunca acá:
# este archivo se carga en el entorno y cada `manage.py test` emitiría comprobantes en ARCA.
