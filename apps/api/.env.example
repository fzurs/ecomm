# Copiar a apps/api/.env y completar. Todas son opcionales: sin ellas rigen los valores por defecto
# de config/settings.py (los indicados abajo). Nunca commitear el .env real.

# --- ARCA (facturación electrónica) ---------------------------------------------------------------

# homologacion (pruebas, sin validez fiscal) o produccion.
ARCA_ENVIRONMENT=homologacion

# Certificado y clave privada. Por defecto, donde los guarda `arca-setup` con carpeta base
# apps/api/certs y alias ecomm: certs/<ARCA_ENVIRONMENT>/ecomm.crt y .key. Rutas relativas a apps/api.
# ARCA_CERTIFICATE_PATH=certs/homologacion/ecomm.crt
# ARCA_PRIVATE_KEY_PATH=certs/homologacion/ecomm.key

# CUIT emisora, sin guiones. Vacía: se lee del certificado.
# ARCA_CUIT=20123456786

# Punto de venta habilitado para factura electrónica (web service) en ARCA.
ARCA_POINT_OF_SALE=1

# responsable_inscripto emite Factura A o B (según el cliente); monotributo, Factura C.
ARCA_ISSUER_VAT_CONDITION=responsable_inscripto

# Datos del emisor que se imprimen en el PDF. Si falta alguno, /invoices/{id}/pdf/ responde 400.
ARCA_ISSUER_LEGAL_NAME=Mi Empresa SRL
ARCA_ISSUER_ADDRESS=Calle Falsa 123, CABA
# Inicio de actividades, AAAA-MM-DD.
ARCA_ISSUER_ACTIVITY_START=2020-01-01
# Ingresos Brutos: número de inscripción, "Exento", etc.
ARCA_ISSUER_GROSS_INCOME=Exento

# --- Asistente del admin (Claude) -----------------------------------------------------------------

# Sin clave, los endpoints del asistente responden con un error.
ANTHROPIC_API_KEY=

# --- Cache -----------------------------------------------------------------------------------------

# Redis del cache `arca` (tickets de acceso de ARCA compartidos entre workers).
REDIS_URL=redis://127.0.0.1:6379

# --- Tests -----------------------------------------------------------------------------------------

# ARCA_INTEGRATION_TESTS y ARCA_TEST_RECEPTOR_CUIT van solo en la línea de comandos, nunca acá:
# este archivo se carga en el entorno y cada `manage.py test` emitiría comprobantes en ARCA.
