# Copiar a apps/web/.env.local. Todas son opcionales.

# URL de la API de Django (apps/api) que usa el servidor de Next. Se lee en el build (rewrites).
API_URL=http://localhost:8000
# URL pública de las imágenes, la misma que MEDIA_URL de Django (next.config.mjs).
MEDIA_URL=http://localhost:8000/media/

# Link del QR de "Data fiscal" que da ARCA (Constancia de inscripción > Formulario 960/D). Sin él,
# el footer no lo muestra: en producción es obligatorio.
# DATA_FISCAL_URL=http://qr.afip.gob.ar/?qr=...

# Contacto de la tienda, para el footer y /help/contact. Los que falten no se muestran.
# STORE_CONTACT_EMAIL=hola@example.com
# STORE_CONTACT_PHONE=+54 11 5555-0000
# STORE_CONTACT_ADDRESS=Av. Corrientes 1234, CABA
# STORE_CONTACT_HOURS=Lunes a viernes de 9 a 18
