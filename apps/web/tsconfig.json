{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/api-client": ["../../packages/api-client/src/index.ts"],
      "@workspace/api-client/allauth": [
        "../../packages/api-client/src/allauth/index.ts"
      ],
      "@workspace/api-client/allauth/client": [
        "../../packages/api-client/src/allauth/client.gen.ts"
      ]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
