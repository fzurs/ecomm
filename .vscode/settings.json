{
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/.pnpm-store/**": true,
    "**/__pycache__/**": true,
    "apps/api/media/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true
  },
  "python.analysis.exclude": ["**/node_modules", "**/.next", "apps/api/media"]
}
